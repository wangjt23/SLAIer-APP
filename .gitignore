# =====================================================================================
# Signing material — NEVER commit these.
#
# keystore.properties holds the keystore password in plain text, and the .jks file *is*
# the app's identity: anyone who gets both can publish an "update" to your users.
# `keystore.properties.example` is committed instead, so the build stays reproducible.
# =====================================================================================
keystore.properties
keystore/
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# =====================================================================================
# Local reconnaissance notes.
#
# The endpoint notes, HAR exports and raw captures contain live cookies, tokens and the
# student's own data. `docs/*.local.md` is the convention for "my machine only".
# =====================================================================================
docs/*.local.md
captures/
*.har
*.har.gz

# =====================================================================================
# Machine-specific configuration
# =====================================================================================
local.properties
.idea/
*.iml
.DS_Store
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# =====================================================================================
# Build output
# =====================================================================================
build/
app/build/
*/build/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json
baselineProfiles/

# Release artifacts live on GitHub Releases, not in git history (they are 2–25 MB of
# binaries that change on every build, and they would bloat every clone forever).
dist/

# =====================================================================================
# Assorted
# =====================================================================================
*.log
*.tmp
*.swp
*~

# The school's presentation template (10 MB). It is only a colour reference; the assets it
# was used to derive are committed under theme/ and regenerated by tools/make-assets.py.
theme/*.pptx
