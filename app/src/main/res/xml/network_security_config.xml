<?xml version="1.0" encoding="utf-8"?>
<!--
  Defence in depth: cleartext is disabled in the manifest *and* here, and the app never calls
  handler.proceed() on an SSL error.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
