<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads the school systems. Required. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Distinguishes "offline" from "server error" so the UI can show the right message. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ runtime permission for class reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm class reminders after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Exact reminders are opt-in only (Settings > 精确提醒). SCHEDULE_EXACT_ALARM is requested at
      runtime via Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM; the app degrades to an inexact
      alarm when the permission is not granted.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 应用内更新：把下载好的 APK 交给系统安装器（用户仍需在系统里允许"安装未知应用"）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- No feature is mandatory: the app is a browser + cache client. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".CampusApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.SlaiCampus"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SlaiCampus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Only school hosts may be opened by this receiver; it is not exported and the action is
          app-internal. See SchoolPage / AllowedHosts for the host allow-list.
        -->
        <receiver
            android:name=".reminder.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager is initialised through Hilt (CampusApp implements Configuration.Provider), so
          the default initializer must be removed.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <!-- PackageInstaller 的安装结果回调（显式 PendingIntent，不导出）。 -->
        <receiver
            android:name=".data.update.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.slai.campus.action.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
