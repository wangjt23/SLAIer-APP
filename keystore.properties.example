# Copy to `keystore.properties` and fill in your own values.
#
# `keystore.properties` is gitignored — it contains the keystore password in plain text.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/release.jks -alias campus \
#           -keyalg RSA -keysize 2048 -validity 10950 \
#           -dname "CN=Your Name, OU=Personal, O=Personal, L=City, ST=Province, C=CN"
#
# If this file is absent, `assembleRelease` still works: app/build.gradle.kts falls back to
# the debug signing config, which produces an installable (but not publishable) APK.

storeFile=keystore/release.jks
storePassword=CHANGE_ME
keyAlias=campus
keyPassword=CHANGE_ME
